# Copy to agent/.env for local runs. Never commit the real file.

# The same token as COOLCANDLE_AGENT_TOKEN in backend/.env. At least 32 characters.
COOLCANDLE_AGENT_TOKEN=
COOLCANDLE_AGENT_CORE_URL=http://localhost:8000

# Without a key the buddy answers that it is not set up.
# COOLCANDLE_AGENT_ANTHROPIC_API_KEY=
