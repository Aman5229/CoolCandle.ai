# Copy to backend/.env for local runs. Never commit the real file.

# Make one with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOLCANDLE_SECRET_KEY=

COOLCANDLE_DATABASE_URL=postgresql+asyncpg://coolcandle:coolcandle@localhost:5432/coolcandle
COOLCANDLE_ALLOWED_ORIGIN=http://localhost:5173
COOLCANDLE_PUBLIC_URL=http://localhost:5173
COOLCANDLE_COOKIE_SECURE=false

# sim: made-up prices and a simulated clock, no broker needed. kotak: the real feed.
COOLCANDLE_MARKET_SOURCE=sim
COOLCANDLE_SIM_SPEED=1
# A lock holds for its whole date, so set a new date to start a fresh simulated day.
# COOLCANDLE_SIM_DATE=2026-11-12

# Optional: the trading buddy runs as its own service (agent/). Set both, with the same token in
# agent/.env. Make a token with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# COOLCANDLE_AGENT_URL=http://localhost:8001
# COOLCANDLE_AGENT_TOKEN=

# Optional: alerts to your own Telegram chat.
# COOLCANDLE_TELEGRAM_BOT_TOKEN=
# COOLCANDLE_TELEGRAM_CHAT_ID=
# COOLCANDLE_NEWS_RSS_URLS=["https://example.com/markets.rss"]

# Live trailing stays off until Kotak confirms automatic exits are allowed.
# COOLCANDLE_TRAILING_LIVE_ENABLED=false
